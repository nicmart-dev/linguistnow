# =============================================================================
# Docker Compose Local Override Example
# =============================================================================
# Copy this file to docker-compose.override.yml to customize your local dev
# environment without modifying the main docker-compose.yml.
#
# Docker Compose automatically loads docker-compose.override.yml when running
# `docker compose up` locally.
# =============================================================================

# services:
  # Example: Source code bind-mounts for live-reloading during development
  # backend:
  #   volumes:
  #     - ./server:/app/server
  #     - /app/node_modules

  # frontend:
  #   volumes:
  #     - ./client:/app/client
  #     - /app/node_modules

  # NOTE: To change host ports, setting BACKEND_PORT=5000 or FRONTEND_PORT=3000
  # in your .env file is recommended. If overriding ports here, use !override
  # to replace the base ports instead of appending:
  # backend:
  #   ports: !override
  #     - "5000:5000"
  # frontend:
  #   ports: !override
  #     - "3000:80"

# Example: Use a local isolated bridge network instead of the shared host network
# networks:
#   default:
#     name: linguistnow-local-net
#     external: false
