# =============================================================================
# LinguistNow - Environment Variables for Docker Deployment
# =============================================================================
# Copy this file to .env and configure for your deployment.
# Works with Dockhand, Dockge, Portainer, or standard Docker Compose CLI.
# =============================================================================

# -----------------------------------------------------------------------------
# Port Configuration
# -----------------------------------------------------------------------------
# Host ports for each service (container ports are fixed internally)
BACKEND_PORT=5050
FRONTEND_PORT=3030
REDIS_PORT=6379
REDIS_BIND_IP=127.0.0.1
FRANKFURTER_PORT=8080
FRANKFURTER_BIND_IP=127.0.0.1

# -----------------------------------------------------------------------------
# Networking Configuration
# -----------------------------------------------------------------------------
# DOCKER_NETWORK_NAME: Network name to attach containers to (default: shared_net)
# USE_EXTERNAL_NETWORK: Set to true if shared_net already exists on Docker host.
# Set to false for local dev to let Docker Compose automatically create it.
DOCKER_NETWORK_NAME=shared_net
USE_EXTERNAL_NETWORK=true

# -----------------------------------------------------------------------------
# URL Configuration
# -----------------------------------------------------------------------------
# FRONTEND_URL: The public URL where users access the app
# This is used for:
#   - OAuth redirect URI (must match Google Console configuration)
#   - CORS configuration on the backend
#
# Examples:
#   - With reverse proxy: https://linguistnow.yourdomain.com
#   - Direct access: http://192.168.1.100:3030
FRONTEND_URL=http://localhost:3030

# BACKEND_URL: The public URL for the API
# Used for Swagger API documentation "Try it out" functionality
BACKEND_URL=http://localhost:5050

# -----------------------------------------------------------------------------
# Google OAuth Configuration (Required)
# -----------------------------------------------------------------------------
# Get these from: https://console.cloud.google.com/apis/credentials
# The redirect URI in Google Console must match FRONTEND_URL exactly
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# -----------------------------------------------------------------------------
# Airtable Database (Required)
# -----------------------------------------------------------------------------
# Personal Access Token: https://airtable.com/create/tokens
AIRTABLE_PERSONAL_ACCESS_TOKEN=your_token_here
# Base ID: Found in your Airtable URL (starts with "app")
AIRTABLE_BASE_ID=your_base_id_here

# -----------------------------------------------------------------------------
# HashiCorp Vault Configuration
# -----------------------------------------------------------------------------
# Internal address of Vault container on shared network
VAULT_ADDR=http://shared-vault:8200
VAULT_TOKEN=your_vault_token_here
VAULT_SECRET_PATH=secret/data/linguistnow/tokens

# -----------------------------------------------------------------------------
# FX Rates Service Configuration (Redis & Frankfurter)
# -----------------------------------------------------------------------------
# Internal URLs on shared Docker network (defaults shown)
REDIS_URL=redis://redis:6379
FRANKFURTER_URL=http://frankfurter:8080
FRANKFURTER_FALLBACK_URL=https://api.frankfurter.dev/v1
# Optional: API key required for external access to internal/management endpoints (/api/tokens/*, GET /api/users, POST /api/currency/refresh)
INTERNAL_API_KEY=

# =============================================================================
# IMPORTANT: Frontend Environment Variables (Build-time only!)
# =============================================================================
# The following variables are ONLY used when BUILDING the frontend from source.
# They are baked into the static files and cannot be changed at runtime.
#
# The pre-built ghcr.io images use localhost URLs by default.
# If you need custom URLs, you must rebuild the frontend image or configure
# GitHub repository secrets for the CI/CD workflow.
#
# VITE_API_URL=http://localhost:5050
# VITE_BASE_URL=http://localhost:3030
# VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
# =============================================================================