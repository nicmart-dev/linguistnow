{
  "name": "linguistnow",
  "version": "1.3.4",
  "private": true,
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "start": "pnpm run --parallel --filter ./client --filter ./server start",
    "dev": "concurrently -n \"client,server\" -c \"blue,green\" \"pnpm --filter ./client dev\" \"pnpm --filter ./server dev\"",
    "client": "pnpm --filter ./client start",
    "server": "pnpm --filter ./server start",
    "server-dev": "pnpm --filter ./server dev",
    "install:all": "pnpm install",
    "clean": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "lint:ox": "oxlint .",
    "lint:eslint": "eslint .",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint . --fix",
    "test": "pnpm --filter ./shared test:run && pnpm --filter ./client test:run && pnpm --filter ./server test:run",
    "test:client": "pnpm --filter ./client test",
    "test:server": "pnpm --filter ./server test",
    "test:shared": "pnpm --filter ./shared test",
    "prepare": "husky",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicmart-dev/linguistnow.git"
  },
  "author": "Nicolas Martinez",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nicmart-dev/linguistnow/issues"
  },
  "homepage": "https://github.com/nicmart-dev/linguistnow",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "concurrently": "^9.2.1",
    "conventional-changelog-conventionalcommits": "^9.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-oxlint": "^1.55.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.55.0",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3",
    "typescript-eslint": "^8.57.0"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.14.1"
    }
  }
}
