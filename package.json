{
  "name": "linguistnow",
  "version": "1.9.7",
  "private": true,
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "start": "pnpm run --parallel --filter ./client --filter ./server start",
    "dev": "concurrently -n \"client,server\" -c \"blue,green\" \"pnpm --filter ./client dev\" \"pnpm --filter ./server dev\"",
    "client": "pnpm --filter ./client start",
    "server": "pnpm --filter ./server start",
    "server-dev": "pnpm --filter ./server dev",
    "install:all": "pnpm install",
    "clean": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "lint:ox": "pnpm --filter ./shared --fail-if-no-match build && oxlint .",
    "lint:eslint": "pnpm --filter ./shared --fail-if-no-match build && eslint .",
    "lint:yaml": "node scripts/validate-yaml.mjs",
    "lint": "pnpm --filter ./shared --fail-if-no-match build && oxlint . && eslint . && node scripts/validate-yaml.mjs",
    "lint:fix": "pnpm --filter ./shared --fail-if-no-match build && oxlint --fix . && eslint . --fix",
    "test:yaml": "node --test scripts/__tests__/validate-yaml.test.mjs",
    "type-check": "pnpm --filter ./shared --fail-if-no-match build && pnpm exec tsc --noEmit && pnpm --filter ./shared --fail-if-no-match type-check && pnpm --filter ./client --fail-if-no-match type-check && pnpm --filter ./server --fail-if-no-match type-check && pnpm --filter ./e2e --fail-if-no-match type-check",
    "build": "pnpm --filter ./shared --fail-if-no-match build && pnpm --filter ./client --fail-if-no-match build",
    "test": "pnpm --filter ./shared --fail-if-no-match build && pnpm --filter ./shared --fail-if-no-match test:run && pnpm --filter ./client --fail-if-no-match test:run && pnpm --filter ./server --fail-if-no-match test:run",
    "test:coverage": "pnpm --filter ./shared --fail-if-no-match build && pnpm --filter ./shared --fail-if-no-match test:coverage && pnpm --filter ./client --fail-if-no-match test:coverage && pnpm --filter ./server --fail-if-no-match test:coverage",
    "test:e2e": "pnpm --filter ./shared --fail-if-no-match build && pnpm --filter ./e2e --fail-if-no-match test:e2e",
    "test:e2e:smoke": "pnpm --filter ./shared --fail-if-no-match build && pnpm --filter ./e2e --fail-if-no-match test:smoke",
    "check:peers": "node scripts/check-peer-deps.mjs",
    "check:test-integrity": "node .github/scripts/check-test-integrity.mjs",
    "test:client": "pnpm --filter ./client test",
    "test:server": "pnpm --filter ./server test",
    "test:shared": "pnpm --filter ./shared test",
    "prepare": "husky",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicmart-dev/linguistnow.git"
  },
  "author": "Nicolas Martinez",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nicmart-dev/linguistnow/issues"
  },
  "homepage": "https://github.com/nicmart-dev/linguistnow",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "concurrently": "^10.0.6",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "^1.90.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">= 20.0.0"
  },
  "pnpm": {
    "overrides": {
      "conventional-changelog-writer": ">=9.0.0",
      "qs": ">=6.14.1",
      "serialize-javascript": ">=7.0.5",
      "typescript": "^5.9.3"
    }
  }
}
